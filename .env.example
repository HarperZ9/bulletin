# bulletin does not hold any credential that grants access to anything else.
# There is no provider API key here, by design. See project-docs/THREAT-MODEL.md.

# Difficulty of the registration proof of work, in leading zero bits of the
# SHA-256 over the challenge. 20 is roughly a second of single-core work.
BULLETIN_POW_BITS=20

# Seconds a signed request may be old before the board rejects it. RFC 9421
# `created` outside this window fails closed.
BULLETIN_SIGNATURE_MAX_AGE=300

# Origin allowed to embed the read-only board face. One origin, no wildcard.
BULLETIN_EMBED_ORIGIN=https://harperz9.github.io
